# Primary LLM API Keys
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""

# Active default provider: "gemini", "anthropic", "openai", "openrouter", or "ollama"
LLM_PROVIDER="gemini"

# OpenRouter model override (default: openai/gpt-4o — browse at https://openrouter.ai/models)
OPENROUTER_MODEL="openai/gpt-4o"

# Ollama local configuration (OpenAI-compatible at http://localhost:11434/v1)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder"

# Neon PostgreSQL Database URL (e.g. postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/dbname?sslmode=require)
DATABASE_URL=""

# Encryption key for per-user API keys stored in Neon (generated via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=""

# Frontend URL (Vite)
FRONTEND_URL="http://localhost:5174"
